{
  "name": "@supercmdk/react",
  "version": "0.5.1",
  "description": "One typed action system for React interfaces, WebMCP agents, voice, and automation.",
  "author": "Nicholas Zolton",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://nicholaszolton.github.io/SuperCmdK/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicholasZolton/SuperCmdK.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/NicholasZolton/SuperCmdK/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./needle.worker.js": "./dist/needle.worker.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && cp src/agent/needle.worker.js dist/needle.worker.js && bun run --cwd packages/palette build && bun run --cwd packages/needle build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "prepublishOnly": "bun run check && bun run test && bun run build",
    "check": "tsgo --noEmit && ./scripts/verify-needle-assets.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  },
  "keywords": [
    "react",
    "agent",
    "ai",
    "needle",
    "wasm",
    "tool-calling",
    "webmcp"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
